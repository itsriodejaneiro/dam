# Development defaults. `bun run dev` copies this file to .env on a clean clone.
# Bun, Vite and Docker Compose all read the .env.

# One Compose project per checkout, so that two `bun run dev` never share a container.
COMPOSE_PROJECT_NAME=dam-main

# A second checkout on the same machine needs its own values for these four.
PB_PORT=8090
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
PB_ADMIN_URL=http://127.0.0.1:8090/_/
APP_URL=http://localhost:5173

# The superuser the container creates on a new database, for the scripts, the server
# side and the PocketBase admin. Development only: a deploy sets its own.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=dev-password-123
