	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "vite build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test src",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"shots": "playwright test --project=screens",
		"e2e:security": "playwright test --project=security",
		"db:setup": "bun run scripts/setup-collections.ts",
		"db:reset": "bun run scripts/reset-db.ts",
		"db:seed-maps": "bun run scripts/seed-main-map.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-drag": "^3.0.7",
		"@types/d3-force": "^3.0.10",
		"@types/d3-selection": "^3.0.11",
		"@types/node": "^25.6.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitepress": "^1.6.4"
	},
	"dependencies": {
		"@lucide/svelte": "^1.14.0",
		"@tiptap/core": "^3.22.5",
		"@tiptap/pm": "^3.22.5",
		"@tiptap/starter-kit": "^3.22.5",
		"d3-drag": "^3.0.0",
		"d3-force": "^3.0.0",
		"d3-selection": "^3.0.0",
		"pocketbase": "^0.26.8",
		"svg-country-flags": "^1.2.10"
	}
}
